# ============================================================
# Variables de entorno
# ============================================================
# Este archivo SI se sube al repositorio: documenta los NOMBRES de las
# variables que hay que configurar, con valores de ejemplo.
#
# El archivo .env con los valores REALES esta en .gitignore y nunca
# se sube. Copiar este archivo y completar:
#
#   cp .env.example .env
# ============================================================


# ----------------------------------------------------------
# Aplicacion
# ----------------------------------------------------------
NODE_ENV=development
PORT=3000

# URL publica del servicio. En desarrollo es local.
# En produccion es el dominio real (https://auth.midominio.com).
# OJO: el issuer del JWT tiene que coincidir EXACTAMENTE con esta URL.
APP_URL=http://localhost:3000


# ----------------------------------------------------------
# Base de datos
# ----------------------------------------------------------
# Desarrollo local (docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_service

# Produccion (Neon). Conseguir el valor en el panel de Neon.
# DATABASE_URL=postgresql://usuario:password@ep-xxx.sa-east-1.aws.neon.tech/auth_service?sslmode=require


# ----------------------------------------------------------
# JWT (access tokens)
# ----------------------------------------------------------
# Generar un par de llaves ES256 (criptografia asimetrica: la privada firma
# los tokens, la publica los verifica). El script esta en
# apps/auth-service/scripts/generate-keys.ts
#
# En Windows las llaves multilinea van entre comillas dobles.
# OJO: la publica va a /.well-known/jwks.json, asi que puede ser publica.
# La privada NUNCA sale del servidor.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REEMPLAZAR_CON_LA_LLAVE_PRIVADA
-----END PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
REEMPLAZAR_CON_LLAVE_PUBLICA
-----END PUBLIC KEY-----"

# Identificador de la llave. Sirve para rotar llaves sin downtime.
# Cuando se rote, se cambia este valor y se publica la nueva en jwks.json.
JWT_KEY_ID=key-2026-01

# Debe coincidir exactamente con APP_URL. Es lo que valida el cliente
# para asegurarse de que los tokens vienen de este servicio y no de otro.
JWT_ISSUER=http://localhost:3000

# A quien es dirigido el token (normalmente el nombre del cliente).
JWT_AUDIENCE=auth-service-clients


# ----------------------------------------------------------
# Duracion de los tokens
# ----------------------------------------------------------
# Access token: corto, porque NO es revocable.
ACCESS_TOKEN_TTL=15m

# Refresh token: largo, porque SI es revocable (esta en la base de datos).
REFRESH_TOKEN_TTL=30d

# Authorization code: muy corto, dura un solo uso.
AUTH_CODE_TTL=60s

# Token de verificacion de email.
EMAIL_VERIFICATION_TTL=24h

# Token de reset de contrasena: expiracion corta, es el mas sensible.
PASSWORD_RESET_TTL=15m


# ----------------------------------------------------------
# Origenes permitidos (CORS)
# ----------------------------------------------------------
# Lista blanca separada por comas. NUNCA usar * : con credenciales
# habilitadas seria un agujero de robo de sesion.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ----------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------
# memory = development y tests (no necesita nada externo)
# upstash = produccion (OBLIGATORIO en Vercel)
RATE_LIMIT_STORE=memory

# Solo cuando RATE_LIMIT_STORE=upstash. Se consiguen en el panel de Upstash.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=REEMPLAZAR


# ----------------------------------------------------------
# Limites de rate limiting
# ----------------------------------------------------------
# Intentos de login fallidos por email antes de bloquear la cuenta.
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5

# Minutos de bloqueo de la cuenta cuando se supera el limite.
LOGIN_LOCKOUT_MINUTES=15

# Requests por IP por minuto, para todos los endpoints.
RATE_LIMIT_REQUESTS_PER_MINUTE=20


# ----------------------------------------------------------
# Email (Resend)
# ----------------------------------------------------------
# API key de https://resend.com
RESEND_API_KEY=re_REEMPLAZAR_CON_TU_API_KEY

# Remitente. Tiene que ser un dominio verificado en Resend.
EMAIL_FROM=Auth Service <auth@midominio.com>

# URL base para los links de los emails (verificacion y reset).
EMAIL_FROM_NAME=Auth Service


# ----------------------------------------------------------
# Login social con Google (version 2 del proyecto)
# ----------------------------------------------------------
# Console de Google Cloud > APIs y servicios > Credenciales.
#
# OJO: el CLIENT_ID si puede ir en el navegador (es publico por diseño).
# El CLIENT_SECRET NUNCA sale del servidor.
GOOGLE_CLIENT_ID=REEMPLAZAR.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REEMPLAZAR

# Redirect URI exacto que hay que registrar en Google.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback


# ----------------------------------------------------------
# Datos de ejemplo para desarrollo
# ----------------------------------------------------------
# Client de ejemplo, se registra en la base de datos con la migracion de seed.
# Es un PUBLIC CLIENT: no tiene secret, se autentica solo con PKCE.
DEV_CLIENT_ID=app-de-desarrollo
DEV_CLIENT_NAME=Cliente de desarrollo
DEV_CLIENT_REDIRECT_URIS=http://localhost:5173/callback
